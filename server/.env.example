PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/hookrelay
REDIS_URL=redis://127.0.0.1:6379
# Public base URL shown in endpoint ingest URLs
PUBLIC_URL=http://localhost:5173
# 64 hex chars (32 bytes) — encrypts signing secrets at rest. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
MAX_ATTEMPTS=6
BACKOFF_BASE_MS=5000
RETENTION_DAYS=14
# Dev only: allow deliveries to localhost / private IPs (SSRF guard is ON by default)
ALLOW_PRIVATE_TARGETS=false
SMTP_URL=
